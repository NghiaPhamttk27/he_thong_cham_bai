generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Problem {
  id          Int          @id @default(autoincrement())
  title       String
  description String
  isHidden    Boolean      @default(false)
  submissions Submission[]
  testcases   TestCase[]   // Bảng Testcase độc lập
}

model TestCase {
  id         Int     @id @default(autoincrement())
  problemId  Int
  problem    Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  testNumber Int
  input      String
  output     String
}

model Submission {
  id          Int              @id @default(autoincrement())
  studentName String
  problemId   Int
  problem     Problem          @relation(fields: [problemId], references: [id])
  code        String
  status      String           // AC, WA, TLE, CE, RE
  score       String           // VD: "2/3"
  createdAt   DateTime         @default(now())
  details     TestcaseResult[]
}

model TestcaseResult {
  id           Int        @id @default(autoincrement())
  submissionId Int
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  testNumber   Int        // Test số mấy (1, 2, 3...)
  status       String     // AC (Đúng), WA (Sai đáp án), TLE (Quá thời gian), RE (Lỗi thực thi/Tràn số)
  actualOutput String?
  errorMessage String?    // Lưu thông tin lỗi nếu có
}